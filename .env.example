# Copy to .env and adjust. Never commit real secrets.

# development | test | production
NODE_ENV=development

# Optional. Render sets this automatically.
PORT=3000

# App DB connection (use the *pooled* connection string on Neon).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keyclashr

# Migrations (use the *direct*, non-pooled connection string on Neon).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keyclashr

# Optional. pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional timing overrides (tests only). Defaults come from shared/src/constants.ts.
# RACE_COUNTDOWN_MS=3000
# RACE_TIME_CAP_MS=180000
# DISCONNECT_GRACE_MS=15000
# ROOM_IDLE_TIMEOUT_MS=600000
